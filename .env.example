APP_ENV=development
APP_NAME=Metus
APP_PORT=8001

DATABASE_URI=mongodb://localhost/zmeta
DATABASE_NAME=zmeta

# Bắt buộc, dùng chuỗi ngẫu nhiên dài (vd: openssl rand -hex 32). Phải trùng secret của BE.
JWT_CLIENT_SECRET_KEY=

# Bật/tắt job (true | false). Không đặt thì dùng mặc định ghi bên cạnh.
# Nạp tiền qua Web2M (mặc định: true)
JOB_BANK_ENABLE=true
# Nạp tiền theo từng site, gọi thẳng ACB (mặc định: false)
JOB_AUTO_BANK_ENABLE=false
# Đồng bộ giá SMM (mặc định: true)
JOB_CHECK_PRICE_ENABLE=true
# Đồng bộ trạng thái đơn SMM (mặc định: true)
JOB_CHECK_SMM_ORDER=true
# Gỡ app Facebook khi gói hết hạn (mặc định: true)
JOB_CANCEL_PLAN_ENABLE=true
# Nạp tiền USDT qua ví Binance (mặc định: false, cần BINANCE_API_KEY/SECRET và setting USDT_INFO)
JOB_USDT_ENABLE=false

# Binance API key chỉ-đọc (Enable Reading), khóa theo IP server. Dùng cho nạp USDT.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Tùy chọn, mặc định https://api.binance.com
BINANCE_API_BASE=
# Các origin của FE được phép gọi GET /api/usdt/info, ngăn cách bằng dấu phẩy.
USDT_CORS_ORIGINS=

# Bot Telegram (tạo qua @BotFather, thêm bot vào nhóm và cho quyền gửi tin).
TELEGRAM_BOT_TOKEN=
# Chat ID nhận từng loại thông báo (nhóm có dạng -100xxxxxxxxxx). Có thể dùng chung một chat cho cả 4 loại.
TELEGRAM_CHAT_GENERAL=
TELEGRAM_CHAT_TRANSACTION=
TELEGRAM_CHAT_SMM=
TELEGRAM_CHAT_ERROR=
# Tùy chọn: ID chủ đề (topic) nếu nhóm bật chủ đề, để tách 4 loại trong cùng một nhóm.
TELEGRAM_THREAD_GENERAL=
TELEGRAM_THREAD_TRANSACTION=
TELEGRAM_THREAD_SMM=
TELEGRAM_THREAD_ERROR=
