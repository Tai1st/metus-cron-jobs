APP_ENV=development
APP_NAME=Metus
APP_PORT=8001

DATABASE_URI=mongodb://localhost/zmeta
DATABASE_NAME=zmeta

# Bắt buộc, dùng chuỗi ngẫu nhiên dài (vd: openssl rand -hex 32). Phải trùng secret của BE.
JWT_CLIENT_SECRET_KEY=

# Bật/tắt job (true | false). Không đặt thì dùng mặc định ghi bên cạnh.
# Nạp tiền qua Web2M (mặc định: true)
JOB_BANK_ENABLE=true
# Nạp tiền theo từng site, gọi thẳng ACB (mặc định: false)
JOB_AUTO_BANK_ENABLE=false
# Đồng bộ giá SMM (mặc định: true)
JOB_CHECK_PRICE_ENABLE=true
# Đồng bộ trạng thái đơn SMM (mặc định: true)
JOB_CHECK_SMM_ORDER=true
# Gỡ app Facebook khi gói hết hạn (mặc định: true)
JOB_CANCEL_PLAN_ENABLE=true

DISCORD_BOT_TOKEN=
DISCORD_DEVELOPMENT_GUILD_ID=
DISCORD_CHANNEL_GENERAL=
DISCORD_CHANNEL_TRANSACTION=
DISCORD_CHANNEL_SMM=
DISCORD_CHANNEL_ERROR=
